# Copy to .env on the server. Never commit the real file.
APP_NAME="Wow Salon"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # docker compose run --rm app php artisan key:generate --show
APP_URL=https://salon.example.com # must match APP_DOMAIN; used in WhatsApp links
APP_DOMAIN=salon.example.com      # only used by the optional Caddy service (--profile caddy)
APP_PORT=8085                     # host port (localhost only) your reverse proxy forwards to
APP_TIMEZONE=Asia/Kolkata
APP_IMAGE=ghcr.io/gauravjiandanigj/salon-invoice-mgmt:latest

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SEED_OWNER_PASSWORD=change-me-before-first-boot
SEED_DEMO_DATA=false
WHATSAPP_DRIVER=wame

# Backups (optional): DigitalOcean Spaces / any S3-compatible bucket
BACKUP_SPACES_ENABLED=false
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=blr1
SPACES_BUCKET=
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
BACKUP_NOTIFY_EMAIL=
